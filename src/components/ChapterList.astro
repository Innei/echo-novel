---
import { getCollection } from 'astro:content';

const all = await getCollection('chapters');
const sorted = all.sort((a, b) => a.data.order - b.data.order);

const slugOf = (order: number) => (order === 0 ? 'prologue' : String(order));

const entries = sorted.map((entry) => ({
  href: `/chapters/${slugOf(entry.data.order)}`,
  order: entry.data.order,
  title: entry.data.title,
}));
---

<ol class="chapters">
  {
    entries.map((e) => (
      <li class="chapter-item">
        <a href={e.href} class="chapter-link">
          <span class="chapter-num mono">
            {String(e.order).padStart(2, '0')}
          </span>
          <span class="chapter-title">{e.title}</span>
          <span class="chapter-arrow mono" aria-hidden="true">→</span>
        </a>
      </li>
    ))
  }
</ol>

<style>
  .chapters {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 1px solid var(--border);
  }
  .chapter-item {
    border-bottom: 1px solid var(--border);
  }
  .chapter-link {
    display: grid;
    grid-template-columns: 3.4rem 1fr auto;
    align-items: baseline;
    gap: 1.2rem;
    padding: 0.95rem 0.4rem;
  }
  .chapter-num {
    color: var(--accent);
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    font-variant-numeric: tabular-nums;
  }
  .chapter-title {
    font-family: var(--font-serif);
    font-size: 1.05rem;
    color: var(--fg);
    letter-spacing: 0.005em;
    text-decoration: underline solid transparent;
    text-decoration-thickness: 1px;
    text-underline-offset: 5px;
    transition: color 0.18s var(--ease),
                text-decoration-color 0.18s var(--ease);
  }
  .chapter-arrow {
    color: var(--accent);
    font-size: 0.9rem;
    opacity: 0;
    transform: translateX(-4px);
    transition: opacity 0.18s var(--ease),
                transform 0.18s var(--ease);
  }
  .chapter-link:hover .chapter-title,
  .chapter-link:focus-visible .chapter-title {
    color: var(--accent);
    text-decoration-color: var(--accent);
  }
  .chapter-link:hover .chapter-arrow,
  .chapter-link:focus-visible .chapter-arrow {
    opacity: 1;
    transform: translateX(0);
  }
  .chapter-link:focus-visible {
    outline: 1px dashed var(--accent);
    outline-offset: 2px;
  }
  @media (max-width: 640px) {
    .chapter-link {
      grid-template-columns: 2.6rem 1fr auto;
      gap: 0.85rem;
      padding: 0.85rem 0.2rem;
    }
    .chapter-title {
      font-size: 1rem;
    }
    .chapter-arrow {
      opacity: 1;
      transform: none;
      color: var(--fg-mute);
      font-size: 0.8rem;
    }
  }
</style>
