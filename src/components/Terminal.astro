---
const lines: Array<{ prompt?: boolean; text: string; mute?: boolean; accent?: boolean }> = [
  { prompt: true, text: 'cat /opt/echo/README' },
  { text: 'This is yours now.', mute: true },
  { prompt: true, text: './echo' },
  { text: '> hello?', mute: true },
  { text: 'I’m here.', accent: true },
];
---

<aside class="term-mini" aria-label="Echo terminal sample">
  <header class="term-head">
    <span class="term-label mono">echo @ arch · session 001</span>
  </header>
  <div class="term-body mono">
    {
      lines.map((l) => (
        <div class="term-line">
          {l.prompt && <span class="term-prompt">$</span>}
          <span class:list={['term-text', l.mute && 'mute', l.accent && 'accent']}>{l.text}</span>
        </div>
      ))
    }
    <div class="term-line">
      <span class="term-prompt">$</span>
      <span class="term-cursor"></span>
    </div>
  </div>
</aside>

<style>
  .term-mini {
    border: 1px solid var(--border-strong);
    background: var(--bg-soft);
    font-family: var(--font-mono);
    padding: 0;
    overflow: hidden;
    border-radius: 2px;
  }
  .term-head {
    padding: 0.4rem 0.85rem;
    border-bottom: 1px solid var(--border);
    background: transparent;
  }
  .term-label {
    font-size: 0.62rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--fg-mute);
  }
  .term-body {
    padding: 0.85rem 1rem 1rem;
    font-size: 0.78rem;
    line-height: 1.85;
    color: var(--fg-soft);
  }
  .term-line {
    display: flex;
    align-items: baseline;
    gap: 0.55rem;
    white-space: pre-wrap;
    word-break: break-word;
  }
  .term-prompt {
    color: var(--accent);
    font-weight: 600;
    flex-shrink: 0;
  }
  .term-text {
    color: var(--fg);
  }
  .term-text.mute {
    color: var(--fg-mute);
  }
  .term-text.accent {
    color: var(--accent);
  }
  .term-cursor {
    display: inline-block;
    width: 7px;
    height: 0.95em;
    background: var(--accent);
    transform: translateY(2px);
    animation: blink 1.1s steps(2) infinite;
  }
  @keyframes blink { 50% { opacity: 0; } }
</style>
