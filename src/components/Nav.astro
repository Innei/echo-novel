---
interface Props {
  variant?: 'home' | 'chapter';
  volume?: number;
}
const { variant = 'home', volume = 1 } = Astro.props;
const volLabel = `Vol. ${volume}`;
---

<nav class="nav">
  <div class="nav-inner container">
    <a href="/" class="brand">
      <span class="brand-mark">ECHO</span>
      <span class="brand-sep">─</span>
      <span class="brand-vol mono" data-vol-label>{volLabel}</span>
    </a>
    <div class="nav-actions">
      {variant === 'chapter' && (
        <a href="/" class="nav-link mono" aria-label="返回目录">目录</a>
      )}
      <button id="theme-toggle" class="theme-btn mono" aria-label="切换主题">
        <span class="t-light">灯</span>
        <span class="t-dark">夜</span>
      </button>
    </div>
  </div>
</nav>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in oklab, var(--bg) 92%, transparent);
    backdrop-filter: saturate(140%) blur(14px);
    -webkit-backdrop-filter: saturate(140%) blur(14px);
    border-bottom: 1px solid var(--border);
  }
  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 60px;
  }
  .brand {
    display: inline-flex;
    align-items: baseline;
    gap: 0.7rem;
    transition: opacity 0.2s var(--ease);
  }
  .brand:hover { opacity: 0.75; }
  .brand-mark {
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: 1.2rem;
    letter-spacing: 0.06em;
    color: var(--fg);
  }
  .brand-sep {
    font-family: var(--font-mono);
    color: var(--fg-mute);
    font-size: 0.9rem;
  }
  .brand-vol {
    font-size: 0.74rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--fg-mute);
  }
  .nav-actions {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }
  .nav-link {
    padding: 0.4rem 0.8rem;
    font-size: 0.74rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    border-radius: 3px;
    color: var(--fg-soft);
    transition: background 0.2s var(--ease), color 0.2s var(--ease);
  }
  .nav-link:hover {
    background: var(--accent-soft);
    color: var(--accent);
  }
  .theme-btn {
    padding: 0.4rem 0.8rem;
    border-radius: 3px;
    font-size: 0.74rem;
    letter-spacing: 0.16em;
    color: var(--fg-soft);
    transition: background 0.2s var(--ease), color 0.2s var(--ease);
    border: 1px solid var(--border);
  }
  .theme-btn:hover {
    background: var(--accent-soft);
    color: var(--accent);
    border-color: var(--accent);
  }
  .t-light { display: inline; }
  .t-dark { display: none; }
  :global(html[data-theme='dark']) .t-light { display: none; }
  :global(html[data-theme='dark']) .t-dark { display: inline; }
</style>

<script>
  const setup = () => {
    const btn = document.getElementById('theme-toggle');
    if (!btn || (btn as HTMLElement).dataset.bound) return;
    (btn as HTMLElement).dataset.bound = '1';
    btn.addEventListener('click', () => {
      const cur = document.documentElement.dataset.theme || 'light';
      const next = cur === 'dark' ? 'light' : 'dark';
      document.documentElement.dataset.theme = next;
      localStorage.setItem('theme', next);
    });
  };
  setup();
  document.addEventListener('astro:after-swap', setup);
</script>
