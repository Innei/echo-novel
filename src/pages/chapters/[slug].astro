---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import {
  slugOf,
  sortChapters,
  ordinalOf,
  ruleLabelOf,
  volumeLabel,
} from '../../lib/chapter-slug';

export async function getStaticPaths() {
  const all = await getCollection('chapters');
  const sorted = sortChapters(all);
  return sorted.map((entry, idx) => ({
    params: { slug: slugOf(entry.data.volume, entry.data.order) },
    props: {
      entry,
      prev: idx > 0 ? sorted[idx - 1] : null,
      next: idx < sorted.length - 1 ? sorted[idx + 1] : null,
    },
  }));
}

type Props = {
  entry: CollectionEntry<'chapters'>;
  prev: CollectionEntry<'chapters'> | null;
  next: CollectionEntry<'chapters'> | null;
};

const { entry, prev, next } = Astro.props as Props;
const { Content } = await render(entry);

const ordinal = ordinalOf(entry.data.volume, entry.data.order);
const ruleLabel = ruleLabelOf(entry.data.order);
const volLabel = volumeLabel(entry.data.volume);

const wordsRaw = (entry.body ?? '').replace(/[\s\p{P}]/gu, '').length;
const readMin = Math.max(1, Math.round(wordsRaw / 400));
const epigraph = entry.data.epigraph;
const currentSlug = slugOf(entry.data.volume, entry.data.order);
const currentUrl = `/chapters/${currentSlug}`;
const prevSlug = prev ? slugOf(prev.data.volume, prev.data.order) : '';
const nextSlug = next ? slugOf(next.data.volume, next.data.order) : '';
const fullTitle = `${entry.data.title} · Echo`;
---

<Base title={entry.data.title} pageType="chapter" description={entry.data.title}>
  <Nav variant="chapter" volume={entry.data.volume} />
  <main class="chapter-main">
    <article
      class="chapter-article container read-width"
      data-slug={currentSlug}
      data-url={currentUrl}
      data-title={fullTitle}
      data-volume={entry.data.volume}
      data-prev-slug={prevSlug || undefined}
      data-next-slug={nextSlug || undefined}
    >
      <header class="ch-head">
        <div class="chap-rule">
          <span>{volLabel}</span>
          <span class="accent">● {ruleLabel} · {entry.data.title}</span>
        </div>
        <p class="kicker ch-ordinal">{ordinal}</p>
        <h1 class="ch-title">{entry.data.title}</h1>
        <p class="byline ch-meta">
          <span>{wordsRaw.toLocaleString()} 字</span>
          <span class="dot">·</span>
          <span>约 {readMin} 分钟</span>
        </p>
        {epigraph && (
          <blockquote class="ch-epigraph">
            <p>“{epigraph}”</p>
          </blockquote>
        )}
        <div class="ornament">— ECHO —</div>
      </header>

      <div class="prose">
        <Content />
      </div>

      <nav class="ch-pager" aria-label="Chapter navigation">
        {prev ? (
          <a href={`/chapters/${slugOf(prev.data.volume, prev.data.order)}`} class="pager-item prev">
            <span class="pager-label byline">← Previous</span>
            <span class="pager-title">{prev.data.title}</span>
          </a>
        ) : (
          <span class="pager-item disabled">
            <span class="pager-label byline">— Prologue —</span>
            <span class="pager-title">已是开篇</span>
          </span>
        )}
        {next ? (
          <a href={`/chapters/${slugOf(next.data.volume, next.data.order)}`} class="pager-item next">
            <span class="pager-label byline">Next →</span>
            <span class="pager-title">{next.data.title}</span>
          </a>
        ) : (
          <span class="pager-item disabled">
            <span class="pager-label byline">— Fin —</span>
            <span class="pager-title">已是终章</span>
          </span>
        )}
      </nav>

      <div class="back-row">
        <a href="/" class="back-link mono">↩ 返回目录</a>
      </div>
    </article>
  </main>
  <script>
    import('../../scripts/infinite-scroll.ts');
  </script>
</Base>

<style>
  .chapter-main {
    padding: 2.4rem 0 5rem;
  }
  .chapter-article + .chapter-article {
    margin-top: 4.5rem;
    padding-top: 0;
    position: relative;
  }
  .chapter-article + .chapter-article::before {
    content: '';
    display: block;
    width: 5rem;
    height: 1px;
    background: var(--border-strong);
    margin: 0 auto 2.5rem;
  }
  .ch-head {
    margin-bottom: 2.8rem;
  }
  .ch-ordinal {
    margin: 1.4rem 0 0.4rem;
  }
  .ch-title {
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: clamp(1.9rem, 4vw, 2.4rem);
    line-height: 1.2;
    margin: 0 0 0.7rem;
    color: var(--fg);
    letter-spacing: -0.005em;
  }
  .ch-meta {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    flex-wrap: wrap;
    margin: 0 0 1.3rem;
  }
  .ch-meta .dot {
    opacity: 0.5;
  }
  .ch-epigraph {
    margin: 1rem 0 0;
    padding: 0.2em 0 0.2em 1.1em;
    border-left: 2px solid var(--accent);
    color: var(--fg-soft);
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1rem;
    line-height: 1.7;
    max-width: 36em;
  }
  .ch-epigraph p {
    margin: 0;
  }

  .ch-pager {
    margin-top: 4rem;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    border-top: 1px solid var(--border);
    padding-top: 1.6rem;
  }
  .pager-item {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    padding: 0.95rem 1.1rem;
    border: 1px solid var(--border);
    border-radius: 3px;
    background: transparent;
    transition: background 0.2s var(--ease), border-color 0.2s var(--ease), transform 0.2s var(--ease);
  }
  .pager-item.prev { text-align: left; }
  .pager-item.next { text-align: right; }
  .pager-item:not(.disabled):hover {
    background: var(--accent-soft);
    border-color: var(--accent);
    transform: translateY(-1px);
  }
  .pager-item.disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }
  .pager-label {
    color: var(--fg-mute);
  }
  .pager-title {
    font-family: var(--font-serif);
    font-size: 0.98rem;
    color: var(--fg);
  }
  .back-row {
    margin-top: 2rem;
    text-align: center;
  }
  .back-link {
    display: inline-block;
    font-size: 0.74rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--fg-mute);
    padding: 0.5rem 1rem;
    border-radius: 2px;
    transition: color 0.2s var(--ease), background 0.2s var(--ease);
  }
  .back-link:hover {
    color: var(--accent);
    background: var(--accent-soft);
  }

  /* When JS-driven endless scroll is active, hide per-chapter pager/back to
     avoid duplication mid-stream. The very last chapter still benefits from
     its "已是终章" pager — handled via :last-of-type below. */
  :global(html.js-stream) .chapter-article .ch-pager,
  :global(html.js-stream) .chapter-article .back-row { display: none; }
  :global(html.js-stream) .chapter-article:last-of-type .ch-pager,
  :global(html.js-stream) .chapter-article:last-of-type .back-row { display: grid; }
  :global(html.js-stream) .chapter-article:last-of-type .back-row { display: block; }

  .scroll-sentinel {
    height: 1px;
    width: 100%;
    pointer-events: none;
  }

  @media (max-width: 640px) {
    .chapter-main { padding: 1.4rem 0 3rem; }
    .ch-head { margin-bottom: 2rem; }
    .ch-pager { grid-template-columns: 1fr; }
    .pager-item.next { text-align: left; }
    .chapter-article + .chapter-article { margin-top: 3rem; }
    .chapter-article + .chapter-article::before { margin-bottom: 1.8rem; }
  }
</style>
