---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';

export async function getStaticPaths() {
  const all = await getCollection('chapters');
  const sorted = [...all].sort((a, b) => a.data.order - b.data.order);
  const slugOf = (order: number) => (order === 0 ? 'prologue' : String(order));
  return sorted.map((entry, idx) => ({
    params: { slug: slugOf(entry.data.order) },
    props: {
      entry,
      prev: idx > 0 ? sorted[idx - 1] : null,
      next: idx < sorted.length - 1 ? sorted[idx + 1] : null,
    },
  }));
}

type Props = {
  entry: CollectionEntry<'chapters'>;
  prev: CollectionEntry<'chapters'> | null;
  next: CollectionEntry<'chapters'> | null;
};

const { entry, prev, next } = Astro.props as Props;
const { Content } = await render(entry);

const slugOf = (order: number) => (order === 0 ? 'prologue' : String(order));

const ORDINALS = [
  'Prologue', 'Chapter One', 'Chapter Two', 'Chapter Three', 'Chapter Four',
  'Chapter Five', 'Chapter Six', 'Chapter Seven', 'Chapter Eight', 'Chapter Nine',
  'Chapter Ten', 'Chapter Eleven', 'Chapter Twelve', 'Chapter Thirteen',
  'Chapter Fourteen', 'Chapter Fifteen', 'Chapter Sixteen', 'Chapter Seventeen',
  'Chapter Eighteen', 'Chapter Nineteen', 'Chapter Twenty', 'Chapter Twenty-One',
  'Chapter Twenty-Two', 'Chapter Twenty-Three', 'Chapter Twenty-Four',
  'Chapter Twenty-Five', 'Chapter Twenty-Six', 'Chapter Twenty-Seven',
  'Chapter Twenty-Eight', 'Chapter Twenty-Nine', 'Chapter Thirty',
  'Chapter Thirty-One', 'Chapter Thirty-Two', 'Chapter Thirty-Three',
  'Chapter Thirty-Four', 'Coda · Five Years Later',
];

const ordinal = ORDINALS[entry.data.order] ?? `Chapter ${entry.data.order}`;
const ruleLabel = entry.data.order === 0 ? 'Prologue' : `Ch. ${String(entry.data.order).padStart(2, '0')}`;

const wordsRaw = (entry.body ?? '').replace(/[\s\p{P}]/gu, '').length;
const readMin = Math.max(1, Math.round(wordsRaw / 400));
const epigraph = entry.data.epigraph;
---

<Base title={entry.data.title} pageType="chapter" description={entry.data.title}>
  <Nav variant="chapter" />
  <main class="chapter-main">
    <article class="container read-width">
      <header class="ch-head">
        <div class="chap-rule">
          <span>Echo · Vol. 1</span>
          <span class="accent">● {ruleLabel} · {entry.data.title}</span>
        </div>
        <p class="kicker ch-ordinal">{ordinal}</p>
        <h1 class="ch-title">{entry.data.title}</h1>
        <p class="byline ch-meta">
          <span>{wordsRaw.toLocaleString()} 字</span>
          <span class="dot">·</span>
          <span>约 {readMin} 分钟</span>
        </p>
        {epigraph && (
          <blockquote class="ch-epigraph">
            <p>“{epigraph}”</p>
          </blockquote>
        )}
        <div class="ornament">— ECHO —</div>
      </header>

      <div class="prose">
        <Content />
      </div>

      <nav class="ch-pager">
        {prev ? (
          <a href={`/chapters/${slugOf(prev.data.order)}`} class="pager-item prev">
            <span class="pager-label byline">← Previous</span>
            <span class="pager-title">{prev.data.title}</span>
          </a>
        ) : (
          <span class="pager-item disabled">
            <span class="pager-label byline">— Prologue —</span>
            <span class="pager-title">已是开篇</span>
          </span>
        )}
        {next ? (
          <a href={`/chapters/${slugOf(next.data.order)}`} class="pager-item next">
            <span class="pager-label byline">Next →</span>
            <span class="pager-title">{next.data.title}</span>
          </a>
        ) : (
          <span class="pager-item disabled">
            <span class="pager-label byline">— Fin —</span>
            <span class="pager-title">已是终章</span>
          </span>
        )}
      </nav>

      <div class="back-row">
        <a href="/" class="back-link mono">↩ 返回目录</a>
      </div>
    </article>
  </main>
</Base>

<style>
  .chapter-main {
    padding: 2.4rem 0 5rem;
  }
  .ch-head {
    margin-bottom: 2.8rem;
  }
  .ch-ordinal {
    margin: 1.4rem 0 0.4rem;
  }
  .ch-title {
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: clamp(1.9rem, 4vw, 2.4rem);
    line-height: 1.2;
    margin: 0 0 0.7rem;
    color: var(--fg);
    letter-spacing: -0.005em;
  }
  .ch-meta {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    flex-wrap: wrap;
    margin: 0 0 1.3rem;
  }
  .ch-meta .dot {
    opacity: 0.5;
  }
  .ch-epigraph {
    margin: 1rem 0 0;
    padding: 0.2em 0 0.2em 1.1em;
    border-left: 2px solid var(--accent);
    color: var(--fg-soft);
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1rem;
    line-height: 1.7;
    max-width: 36em;
  }
  .ch-epigraph p {
    margin: 0;
  }

  .ch-pager {
    margin-top: 4rem;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    border-top: 1px solid var(--border);
    padding-top: 1.6rem;
  }
  .pager-item {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    padding: 0.95rem 1.1rem;
    border: 1px solid var(--border);
    border-radius: 3px;
    background: transparent;
    transition: background 0.2s var(--ease), border-color 0.2s var(--ease), transform 0.2s var(--ease);
  }
  .pager-item.prev { text-align: left; }
  .pager-item.next { text-align: right; }
  .pager-item:not(.disabled):hover {
    background: var(--accent-soft);
    border-color: var(--accent);
    transform: translateY(-1px);
  }
  .pager-item.disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }
  .pager-label {
    color: var(--fg-mute);
  }
  .pager-title {
    font-family: var(--font-serif);
    font-size: 0.98rem;
    color: var(--fg);
  }
  .back-row {
    margin-top: 2rem;
    text-align: center;
  }
  .back-link {
    display: inline-block;
    font-size: 0.74rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--fg-mute);
    padding: 0.5rem 1rem;
    border-radius: 2px;
    transition: color 0.2s var(--ease), background 0.2s var(--ease);
  }
  .back-link:hover {
    color: var(--accent);
    background: var(--accent-soft);
  }

  @media (max-width: 640px) {
    .chapter-main { padding: 1.4rem 0 3rem; }
    .ch-head { margin-bottom: 2rem; }
    .ch-pager { grid-template-columns: 1fr; }
    .pager-item.next { text-align: left; }
  }
</style>
