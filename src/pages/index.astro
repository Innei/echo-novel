---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Terminal from '../components/Terminal.astro';
import ChapterList from '../components/ChapterList.astro';
import { getCollection } from 'astro:content';

const chapters = await getCollection('chapters');
const totalWords = chapters.reduce(
  (acc, c) => acc + (c.body ?? '').replace(/[\s\p{P}]/gu, '').length,
  0,
);
const chapterCount = chapters.filter((c) => c.data.order > 0).length;
---

<Base title="Echo — 一部小说">
  <Nav />
  <main>
    <section class="hero container">
      <div class="hero-rule chap-rule">
        <span>Echo · Vol. 1</span>
        <span class="accent">● Issue 01 · 2026</span>
      </div>

      <div class="hero-grid">
        <div class="hero-text">
          <p class="hero-kicker kicker">A Novel · 35 Chapters</p>
          <h1 class="hero-headline">
            在二〇一〇年的<br />那个深夜，<br />他遇见了 Echo。
          </h1>
          <p class="hero-lede">
            没有穿越，没有未来记忆。只有一个安静的终端，一个会停下来反问"你为什么想这么做？"的回声，和一个不知道自己能走多远的少年。
          </p>

          <div class="hero-cta">
            <a href="/chapters/prologue" class="cta-primary">
              <span>从序章开始</span>
              <span class="arrow">▸</span>
            </a>
            <a href="#chapters" class="cta-ghost mono">查看目录 ↓</a>
          </div>

          <dl class="hero-meta byline">
            <div>
              <dt>章节</dt>
              <dd>{chapterCount} + 序章 + 番外</dd>
            </div>
            <div>
              <dt>字数</dt>
              <dd>约 {Math.round(totalWords / 1000)} 千字</dd>
            </div>
            <div>
              <dt>时代</dt>
              <dd>2010 — 2018</dd>
            </div>
          </dl>
        </div>

        <div class="hero-side">
          <Terminal />
        </div>
      </div>
    </section>

    <section class="chapters-section container" id="chapters">
      <header class="section-head chap-rule">
        <span>Contents</span>
        <span class="accent">{chapters.length} chapters</span>
      </header>
      <p class="section-sub byline">由序章入 ── 全 {chapters.length} 章节，依序排列</p>
      <ChapterList />
    </section>

    <footer class="foot container">
      <div class="foot-rule chap-rule">
        <span>$ echo --done</span>
        <span class="accent">— fin —</span>
      </div>
      <div class="colophon byline">
        <p>Set in Source Serif 4 & Noto Serif SC. UI in JetBrains Mono.</p>
        <p>Source: <a href="https://github.com/Innei/echo-novel" target="_blank" rel="noopener">github.com/Innei/echo-novel</a></p>
        <p>© 2026 Innei · 文本版权归原作者所有</p>
      </div>
    </footer>
  </main>
</Base>

<style>
  main {
    min-height: 100vh;
  }
  .hero {
    padding: 2.5rem 1.5rem 4rem;
  }
  .hero-rule {
    margin-bottom: 2rem;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: 3rem;
    align-items: start;
  }
  .hero-kicker {
    margin: 0 0 1rem;
  }
  .hero-headline {
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: clamp(2.2rem, 5.5vw, 3.5rem);
    line-height: 1.08;
    margin: 0 0 1.4rem;
    letter-spacing: -0.005em;
    color: var(--fg);
  }
  .hero-lede {
    font-family: var(--font-serif);
    font-size: 1.02rem;
    line-height: 1.75;
    color: var(--fg-soft);
    margin: 0 0 1.8rem;
    max-width: 32em;
  }
  .hero-cta {
    display: flex;
    align-items: center;
    gap: 1.1rem;
    flex-wrap: wrap;
    margin-bottom: 2.2rem;
  }
  .cta-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.65rem 1.1rem;
    background: var(--accent);
    color: #fff;
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 0.78rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    border-radius: 2px;
    transition: transform 0.18s var(--ease), filter 0.18s var(--ease), box-shadow 0.18s var(--ease);
  }
  .cta-primary:hover {
    transform: translateY(-1px);
    filter: brightness(1.1);
    box-shadow: 0 6px 18px var(--accent-soft);
  }
  .cta-primary .arrow {
    transition: transform 0.18s var(--ease);
  }
  .cta-primary:hover .arrow {
    transform: translateX(3px);
  }
  .cta-ghost {
    color: var(--fg-mute);
    font-size: 0.74rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    padding: 0.5rem 0;
    transition: color 0.18s var(--ease);
  }
  .cta-ghost:hover {
    color: var(--accent);
  }
  .hero-meta {
    display: flex;
    gap: 2.4rem;
    flex-wrap: wrap;
    border-top: 1px solid var(--border);
    padding-top: 1.4rem;
    margin: 0;
  }
  .hero-meta div {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .hero-meta dt {
    font-size: 0.66rem;
    color: var(--fg-mute);
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }
  .hero-meta dd {
    margin: 0;
    font-family: var(--font-serif);
    font-size: 0.95rem;
    color: var(--fg);
    font-weight: 500;
    letter-spacing: normal;
    text-transform: none;
  }

  .chapters-section {
    padding: 1rem 1.5rem 4.5rem;
  }
  .section-head {
    margin-bottom: 0.7rem;
  }
  .section-sub {
    margin: 0 0 1.4rem;
    color: var(--fg-mute);
  }

  .foot {
    padding: 1.5rem 1.5rem 4.5rem;
  }
  .foot-rule {
    margin-bottom: 1.4rem;
  }
  .colophon {
    color: var(--fg-mute);
    font-size: 0.66rem;
    line-height: 1.9;
  }
  .colophon p {
    margin: 0;
  }
  .colophon a {
    color: var(--fg-soft);
    text-decoration: underline;
    text-decoration-color: var(--border-strong);
    text-underline-offset: 3px;
    transition: color 0.18s var(--ease);
  }
  .colophon a:hover {
    color: var(--accent);
    text-decoration-color: var(--accent);
  }

  @media (max-width: 900px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 2.4rem;
    }
  }
</style>
